# توکن ربات تلگرام — از BotFather بگیرید
TELEGRAM_BOT_TOKEN=

# شناسه *گروه* (عدد منفی، مثل -1001234567890) — نه آیدی شخصی خودتان.
# بات را به گروه اضافه و ادمین کنید (با اجازه حذف پیام)، بات را اجرا کنید،
# در گروه /id بزنید؛ بات شناسه را می‌گوید.
TELEGRAM_CHAT_ID=

# فاصله اجرا و آستانه امتیاز از پنل تنظیم می‌شوند؛ این‌ها فقط پیش‌فرض اولیه‌اند.
BOT_INTERVAL_MINUTES=30
BOT_SCORE_THRESHOLD=70

# فقط آگهی‌هایی که رهن معادلشان دست‌کم این‌قدر درصد کم شده پیام شوند
NOTIFY_PRICE_DROP_PCT=5

# حداکثر چند آگهی در هر بار اطلاع‌رسانی
NOTIFY_MAX_ITEMS=10

# آدرس عمومی پنل (مثل http://1.2.3.4:8420). اگر ست شود لینک آگهی‌ها در بات از
# صفحه /go/ پنل رد می‌شود تا در اندروید اپ دیوار باز شود؛ پنل باید از بیرون در دسترس باشد.
PUBLIC_URL=

# برای دکمه «شماره تماس» (پنل و تلگرام). در مرورگر در divar.ir لاگین کنید،
# DevTools → Application → Cookies → مقدار کوکی sAccessToken را اینجا بگذارید.
# دیوار دیدن شماره را روزانه محدود می‌کند؛ شماره فقط با کلیک گرفته می‌شود.
DIVAR_AUTH_TOKEN=

# شماره با IP خانه گرفته می‌شود نه IP سرور: tunnel.cmd را روی کامپیوتر خانه اجرا کنید
DIVAR_PROXY=socks5h://127.0.0.1:1080
